# Postgres connection (Neon on Vercel sets this automatically)
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Random long string used to sign admin sessions
AUTH_SECRET=replace-with-a-long-random-string
# First admin login (used only when no admin exists yet)
ADMIN_EMAIL=admin@arnwaterproofing.com
ADMIN_PASSWORD=ChangeMe@123
# Optional: Vercel Blob token for image uploads (otherwise images are stored in Postgres)
BLOB_READ_WRITE_TOKEN=
